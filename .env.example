# Database Configuration (for Postgres/PostGIS/PgSTAC)
POSTGRES_DB=postgis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# STAC FastAPI Database Connection Configuration
PGHOST=postgis
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgis

# STAC FastAPI App Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8080

# TiTiler Server Configuration
TITILER_PORT=8002
TITILER_HOST=0.0.0.0

# Redis Configuration
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Custom Backend & Worker Connection Configuration
DATABASE_URL=postgresql://postgres:postgres@postgis:5432/postgis
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# Backend & Frontend Service Ports (mapped to host)
BACKEND_PORT=8000
FRONTEND_PORT=3000
