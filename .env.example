# Database Configuration (for Postgres/PostGIS/PgSTAC)
POSTGRES_DB=your_postgres_db_here
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_PORT=your_postgres_port_here

# STAC FastAPI Database Connection Configuration
PGHOST=your_postgres_host_here
PGPORT=your_postgres_port_here
PGUSER=your_postgres_user_here
PGPASSWORD=your_postgres_password_here
PGDATABASE=your_postgres_db_here

# STAC FastAPI App Server Configuration
APP_HOST=your_app_host_here
APP_PORT=your_app_port_here

# TiTiler Server Configuration
TITILER_PORT=your_titiler_port_here
TITILER_HOST=your_titiler_host_here

# Redis Configuration
REDIS_PORT=your_redis_port_here

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=your_rabbitmq_user_here
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here
RABBITMQ_PORT=your_rabbitmq_port_here
RABBITMQ_MANAGEMENT_PORT=your_rabbitmq_management_port_here

# Custom Backend & Worker Connection Configuration
DATABASE_URL=your_database_url_here
REDIS_URL=your_redis_url_here
RABBITMQ_URL=your_rabbitmq_url_here

# Backend & Frontend Service Ports (mapped to host)
BACKEND_PORT=your_backend_port_here
FRONTEND_PORT=your_frontend_port_here

# Planet Labs API Key (obtain from planet.com)
PLANET_API_KEY=your_planet_api_key_here

# Mapbox Access Token (obtain from mapbox.com)
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
